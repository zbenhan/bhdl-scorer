rules_version = '2';

// =====================================================================
// 管理部门打分网站 - Cloud Firestore 安全规则
// 部署：Firebase 控制台 → Firestore Database → 规则 → 粘贴全部内容 → 发布
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 当前登录用户的档案（匿名用户无档案）
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function signedIn() {
      return request.auth != null;
    }
    // 有真实档案
    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // 已启用 且 已完成首次改密（业务操作的基本门槛）
    function ready() {
      return profileExists()
        && me().active == true
        && me().mustChangePassword == false;
    }
    function roleIs(r) {
      return ready() && me().role == r;
    }
    // 普通管理员或超级管理员
    function isManager() {
      return ready() && me().role in ['admin', 'superadmin'];
    }
    function isSuper() {
      return roleIs('superadmin');
    }
    // loginIndex 写入目标账号档案（新建代次）
    function targetData() {
      return get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data;
    }
    // 被指向的新账号必须是「启用中、待改密」的打分人员
    function targetIsFreshScorer() {
      return targetData().role == 'scorer'
        && targetData().active == true
        && targetData().mustChangePassword == true;
    }

    // ---------- 初始化标记 ----------
    match /config/{docId} {
      allow read: if signedIn();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // ---------- 员工号 -> 当前生效登录邮箱 ----------
    match /loginIndex/{key} {
      // 登录页匿名会话也需要读取
      allow read: if signedIn();
      // 超管可指向任意角色新账号；普通管理员只能指向打分人员新账号
      allow create, update: if isSuper()
        || (isManager() && request.resource.data.active == true && targetIsFreshScorer());
      allow delete: if false;
    }

    // ---------- 用户档案 ----------
    match /users/{uid} {
      // 本人可读自己档案（含待改密/已停用状态）；管理员可读全部
      allow read: if signedIn() && (request.auth.uid == uid || isManager());

      // 首次初始化固定超级管理员（bootstrap 标记不存在前，仅此一次）
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'superadmin'
        && request.resource.data.protected == true
        && request.resource.data.active == true
        && request.resource.data.mustChangePassword == false
        && request.resource.data.key == 'ADMIN'
        && !exists(/databases/$(database)/documents/config/bootstrap);

      // 管理员新建账号：超管可建管理员/打分人员，普通管理员只能建打分人员
      allow create: if isManager()
        && request.resource.data.role in ['admin', 'scorer']
        && request.resource.data.active == true
        && request.resource.data.mustChangePassword == true
        && request.resource.data.protected != true
        && (isSuper() || request.resource.data.role == 'scorer');

      // 本人完成首次改密后，清除 mustChangePassword 标记（只允许改这一个字段）
      allow update: if signedIn()
        && request.auth.uid == uid
        && me().active == true
        && resource.data.mustChangePassword == true
        && request.resource.data.mustChangePassword == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']);

      // 超管停用/启用/改部门（保护账号除外）
      allow update: if isSuper()
        && resource.data.protected != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'dept']);

      // 普通管理员对打分人员停用/启用/改部门
      allow update: if isManager()
        && resource.data.role == 'scorer'
        && request.resource.data.role == 'scorer'
        && resource.data.protected != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'dept']);

      allow delete: if isSuper() && resource.data.protected != true;
    }

    // ---------- 被打分管理部门 ----------
    match /departments/{deptId} {
      allow read: if ready();
      allow create: if isManager() && request.resource.data.name is string;
      allow update, delete: if isManager();
    }

    // ---------- 打分期次 ----------
    match /rounds/{roundId} {
      allow read: if ready();
      allow create: if isManager()
        && request.resource.data.name is string
        && request.resource.data.status == 'active';
      allow update, delete: if isManager();

      // ---------- 打分记录（文档 ID = 打分人员 key，即员工号大写） ----------
      match /scores/{scorerKey} {
        // 本人只读自己；管理员可读全部
        allow read: if isManager()
          || (ready()
            && me().role == 'scorer'
            && scorerKey == me().key);

        // 打分人员在启用期次创建自己的记录；没有 update 规则 => 提交后不可修改
        allow create: if roleIs('scorer')
          && scorerKey == me().key
          && request.resource.data.key == me().key
          && request.resource.data.employeeId == me().employeeId
          && get(/databases/$(database)/documents/rounds/$(roundId)).data.status == 'active';

        // 管理员重置打分
        allow delete: if isManager();
      }
    }
  }
}
